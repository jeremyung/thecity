+use super::*;
+
+#[test]
+fn shallow_shared_edge_geometry_and_saved_lifecycle_support_42m_blocks() {
+    let mut engine = super::tests::engine_with_developed_plan_site();
+    let mut probe = Engine::restore_json(&engine.save_json()).unwrap();
+    assert!(probe.try_create_neighborhood_plan());
+    let original = probe.state.neighborhood_plan.clone().unwrap();
+    assert!(
+        original.selected_lots.is_some(),
+        "fixture selects a shared-edge block"
+    );
+    let lots = original.selected_lots.as_ref().unwrap();
+    assert!(lots.iter().all(|lot| (lot.depth - 15.9).abs() < 0.01));
+
+    // A parallel open road at 51 m leaves 1 m clearance from the 50 m
+    // perimeter and 9 m from the 42 m perimeter. This isolates the geometry
+    // predicate without changing parcel inventory.
+    let corners: Vec<_> = original
+        .segments
+        .iter()
+        .map(|(from, _)| {
+            let node = probe.node(*from).unwrap();
+            WorldPoint {
+                x: node.x,
+                z: node.z,
+            }
+        })
+        .collect();
+    let offset_dx = corners[2].x - corners[1].x;
+    let offset_dz = corners[2].z - corners[1].z;
+    let offset_length = offset_dx.hypot(offset_dz);
+    let road_scale = 51.0 / offset_length;
+    let edge_length = (corners[1].x - corners[0].x).hypot(corners[1].z - corners[0].z);
+    let tangent_x = (corners[1].x - corners[0].x) / edge_length;
+    let tangent_z = (corners[1].z - corners[0].z) / edge_length;
+    for side in [-1.0_f32, 1.0] {
+        let start_x = corners[0].x + offset_dx * road_scale * side - tangent_x * 20.0;
+        let start_z = corners[0].z + offset_dz * road_scale * side - tangent_z * 20.0;
+        let end_x = corners[1].x + offset_dx * road_scale * side + tangent_x * 20.0;
+        let end_z = corners[1].z + offset_dz * road_scale * side + tangent_z * 20.0;
+        let road_start = engine.add_node(start_x, start_z, "junction");
+        let road_end = engine.add_node(end_x, end_z, "junction");
+        engine.add_road(road_start, road_end, "local", "open", 1.0);
+    }
+
+    let original_corners: [WorldPoint; 4] = corners
+        .iter()
+        .copied()
+        .collect::<Vec<_>>()
+        .try_into()
+        .unwrap();
+    let reused_id = engine
+        .state
+        .roads
+        .iter()
+        .find(|road| {
+            (road.from == original.segments[0].0 && road.to == original.segments[0].1)
+                || (road.to == original.segments[0].0 && road.from == original.segments[0].1)
+        })
+        .unwrap()
+        .id;
+    let context = engine.collision_context();
+    let filtered_50 = engine.available_coordinated_block_lots(&original_corners, &context);
+    let anchor = engine.node(original.anchor_node).unwrap().clone();
+    assert!(!engine.neighborhood_candidate_clear_with_edge(
+        &anchor,
+        &original_corners,
+        &engine.available_station_tower_envelopes(),
+        &context,
+        [
+            Some(original.segments[0].0),
+            Some(original.segments[0].1),
+            None,
+            None
+        ],
+        Some((0, reused_id)),
+        Some(&filtered_50),
+    ));
+    let offset_dx = original_corners[2].x - original_corners[1].x;
+    let offset_dz = original_corners[2].z - original_corners[1].z;
+    let offset_length = offset_dx.hypot(offset_dz);
+    let offset_x = offset_dx / offset_length * 42.0;
+    let offset_z = offset_dz / offset_length * 42.0;
+    let shallow_corners = [
+        original_corners[0],
+        original_corners[1],
+        WorldPoint {
+            x: original_corners[1].x + offset_x,
+            z: original_corners[1].z + offset_z,
+        },
+        WorldPoint {
+            x: original_corners[0].x + offset_x,
+            z: original_corners[0].z + offset_z,
+        },
+    ];
+    let shallow_lots = engine.available_coordinated_block_lots(&shallow_corners, &context);
+    assert!(
+        engine.neighborhood_candidate_clear_with_edge(
+            &anchor,
+            &shallow_corners,
+            &engine.available_station_tower_envelopes(),
+            &context,
+            [
+                Some(original.segments[0].0),
+                Some(original.segments[0].1),
+                None,
+                None
+            ],
+        Some((0, reused_id)),
+            Some(&shallow_lots),
+        ),
+        "the 42 m layout remains feasible"
+    );
+
+    let corner_c = engine.add_node(shallow_corners[2].x, shallow_corners[2].z, "junction");
+    let corner_d = engine.add_node(shallow_corners[3].x, shallow_corners[3].z, "junction");
+    let selected = shallow_lots.clone();
+    engine.state.neighborhood_road_ids.insert(reused_id);
+    engine.state.neighborhood_plan = Some(NeighborhoodPlan {
+        anchor_node: original.anchor_node,
+        segments: vec![
+            original.segments[0],
+            (original.segments[0].1, corner_c),
+            (corner_c, corner_d),
+            (corner_d, original.segments[0].0),
+        ],
+        next_segment: 0,
+        coordinated_lots: true,
+        selected_lots: Some(selected.clone()),
+        spine: None,
+    });
+    engine.validate().unwrap();
+    assert!(selected.iter().all(|lot| (lot.depth - 11.9).abs() < 0.01));
+    let saved = engine.save_json();
+    assert_eq!(Engine::restore_json(&saved).unwrap().save_json(), saved);
+    engine.validate().unwrap();
+
+    let mut replay = Engine::restore_json(&saved).unwrap();
+    for edge in 1..4 {
+        for world in [&mut engine, &mut replay] {
+            assert!(world.plan_next_neighborhood_segment());
+            let (from, to) = world.state.neighborhood_plan.as_ref().unwrap().segments[edge];
+            let project = world
+                .state
+                .projects
+                .iter_mut()
+                .find(|project| {
+                    project.kind == "road"
+                        && project.progress < 1.0
+                        && project.from == Some(from)
+                        && project.to == Some(to)
+                })
+                .expect("the perimeter uses normal road construction");
+            let id = project.id;
+            project.progress = 1.0;
+            world.complete_project(id);
+        }
+        assert_eq!(engine.save_json(), replay.save_json());
+    }
+    assert!(engine.state.neighborhood_plan.is_none());
+    assert!(engine
+        .state
+        .parcels
+        .iter()
+        .any(|parcel| { parcel.rotation.is_some() && (parcel.depth - 11.9).abs() < 0.01 }));
+    engine.validate().unwrap();
+    let canonical = engine.save_json();
+    assert_eq!(
+        Engine::restore_json(&canonical).unwrap().save_json(),
+        canonical
+    );
+}
+
+fn run_seed(seed: u32, treatment: bool, output: &std::path::Path) -> serde_json::Value {
+    let _guard = treatment.then(ShallowSharedBlockExperimentGuard::enabled);
+    let started = std::time::Instant::now();
+    let mut engine = Engine::new(seed);
+    engine.set_development_rate(16);
+    for _ in 0..12_100 {
+        engine.step(20);
+    }
+    assert_eq!(engine.state.tick, 242_000);
+    engine.validate().unwrap();
+    let (fallback_attempts, fallback_winners) = if treatment {
+        ShallowSharedBlockExperimentGuard::counts()
+    } else {
+        (0, 0)
+    };
+    let save = engine.save_json();
+    let snapshot = engine.snapshot_json();
+    let open_buildings = engine
+        .state
+        .buildings
+        .iter()
+        .filter(|b| b.stage == "open")
+        .count();
+    let housing: Vec<_> = engine
+        .state
+        .buildings
+        .iter()
+        .filter(|b| b.stage == "open" && is_housing(b))
+        .collect();
+    let commerce: Vec<_> = engine
+        .state
+        .buildings
+        .iter()
+        .filter(|b| b.stage == "open" && is_commercial(b))
+        .collect();
+    let occupied_housing: u64 = housing.iter().map(|b| b.occupancy as u64).sum();
+    let active_commerce = commerce.iter().filter(|b| b.business_active).count();
+    let ordinary_road_length_m: f64 = engine
+        .state
+        .roads
+        .iter()
+        .filter(|road| {
+            road.stage == "open"
+                && road.connected
+                && !matches!(road.kind.as_str(), "rail" | "bridge")
+        })
+        .map(|road| road.length as f64)
+        .sum();
+    let connected_open_roads = engine
+        .state
+        .roads
+        .iter()
+        .filter(|road| road.stage == "open" && road.connected)
+        .count();
+    let label = if treatment { "fallback" } else { "baseline" };
+    std::fs::write(output.join(format!("seed-{seed}-{label}.json")), &save).unwrap();
+    std::fs::write(
+        output.join(format!("seed-{seed}-{label}-snapshot.json")),
+        snapshot,
+    )
+    .unwrap();
+    let mut restored = Engine::restore_json(&save).unwrap();
+    engine.step(2_000);
+    restored.step(2_000);
+    assert_eq!(engine.save_json(), restored.save_json());
+    let summary = serde_json::json!({
+        "seed": seed,
+        "treatment": label,
+        "development_rate": 16,
+        "tick": 242000,
+        "open_buildings": open_buildings,
+        "housing_occupied": occupied_housing,
+        "active_commerce": active_commerce,
+        "connected_open_roads": connected_open_roads,
+        "ordinary_road_length_m": ordinary_road_length_m,
+        "roads": engine.state.roads.len(),
+        "fallback_attempts": fallback_attempts,
+        "fallback_winner_admissions": fallback_winners,
+        "save_resume_equivalent": true,
+        "elapsed_seconds": started.elapsed().as_secs_f64()
+    });
+    std::fs::write(
+        output.join(format!("seed-{seed}-{label}.summary.json")),
+        serde_json::to_vec_pretty(&summary).unwrap(),
+    )
+    .unwrap();
+    eprintln!("shallow block experiment: {summary}");
+    summary
+}
+
+#[test]
+#[ignore = "controlled matched-seed shallower shared-edge block experiment"]
+fn compare_shallow_shared_edge_fallback_at_mature_seeds() {
+    let output = std::env::var_os("SHALLOW_BLOCK_EXPERIMENT_DIR")
+        .map(std::path::PathBuf::from)
+        .unwrap_or_else(|| {
+            std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+                .parent()
+                .unwrap()
+                .join("validation/shallow-block-experiment")
+        });
+    std::fs::create_dir_all(&output).unwrap();
+    let mut results = Vec::new();
+    for seed in [0, 87_231] {
+        results.push(run_seed(seed, false, &output));
+        results.push(run_seed(seed, true, &output));
+    }
+    std::fs::write(
+        output.join("paired-summary.json"),
+        serde_json::to_vec_pretty(&results).unwrap(),
+    )
+    .unwrap();
+}
