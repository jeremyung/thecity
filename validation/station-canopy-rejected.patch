@@ -7,6 +7,37 @@ import { pedestrianSurface } from '../web/src/movement';
 import { PLATFORM_EDGE_X } from '../web/src/render/rail-profile';
 
 describe('rail platform physical support', () => {
+  it('gives the shared station canopy a bounded twin-pitch roof', () => {
+    const materials = new Map<string, THREE.MeshBasicNodeMaterial>();
+    const art = { get(color: string) { let m=materials.get(color); if(!m){m=new THREE.MeshBasicNodeMaterial();materials.set(color,m);}return m; } };
+    const layout: RailPlatform = {node_id:1,x:0,z:0,ux:0,uz:1,surface_y:8,stair_x:4.05,stair_bottom_z:-20,stair_top_z:-1,ground_y:.27,stair_steps:44};
+    const group=buildStationPlatform(layout,art);group.updateMatrixWorld(true);
+    try {
+      const roof = group.children.find(child => (child as THREE.Mesh).material === materials.get('#546d6c')) as THREE.Mesh;
+      expect(roof).toBeDefined();
+      roof.geometry.computeBoundingBox();
+      const bounds=roof.geometry.boundingBox!;
+      expect(bounds.min.x).toBeGreaterThan(1.9);
+      expect(bounds.min.x).toBeLessThan(2.1);
+      expect(bounds.max.x).toBeGreaterThan(8.9);
+      expect(bounds.max.x).toBeLessThan(9.1);
+      expect(bounds.min.z).toBeCloseTo(-2, 4);
+      expect(bounds.max.z).toBeCloseTo(49, 4);
+      expect(bounds.max.y).toBeGreaterThan(layout.surface_y + 4.1);
+
+      const roofHeight=(x:number) => {
+        const ray=new THREE.Raycaster(new THREE.Vector3(x,20,23.5),new THREE.Vector3(0,-1,0));
+        return ray.intersectObject(roof)[0]?.point.y;
+      };
+      expect(roofHeight(5.5)).toBeGreaterThan(roofHeight(3.7)!);
+      expect(roofHeight(5.5)).toBeGreaterThan(roofHeight(7.3)!);
+      expect(roofHeight(3.7)).toBeCloseTo(roofHeight(7.3)!, 2);
+    } finally {
+      disposeGroup(group);
+      for(const m of materials.values())m.dispose();
+    }
+  });
+
   it('supports every queue slot in rotated and reversed terminal frames', () => {
     const materials = new Map<string, THREE.MeshBasicNodeMaterial>();
     const art = { get(color: string) { let m=materials.get(color); if(!m){m=new THREE.MeshBasicNodeMaterial();materials.set(color,m);}return m; } };
