{
  "name": "thecity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "wasm": "node scripts/build-wasm.mjs",
    "wasm:legacy": "node scripts/build-wasm.mjs --legacy",
    "audit:textures": "node scripts/audit/audit-texture-budget.mjs --out validation/texture-budget.json",
    "check:textures": "node scripts/audit/audit-texture-budget.mjs --check",
    "test": "vitest run",
    "test:engine": "node scripts/test-engine.mjs",
    "setup:fixtures": "python3 scripts/setup-test-fixtures.py",
    "format": "prettier --write \"web/src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" vite.config.ts && cargo fmt --manifest-path engine/Cargo.toml --all",
    "format:check": "prettier --check \"web/src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" vite.config.ts && cargo fmt --manifest-path engine/Cargo.toml --all --check",
    "lint:deps": "depcruise web/src --config .dependency-cruiser.cjs",
    "check:size": "node scripts/check-file-size.mjs",
    "types": "node scripts/generate-types.mjs",
    "build:architecture": "node scripts/build-architecture-assets.mjs",
    "check:architecture": "node scripts/build-architecture-assets.mjs --check",
    "benchmark:architecture": "node scripts/benchmark-apartment-production.mjs",
    "benchmark:districts": "node scripts/benchmark-districts.mjs",
    "benchmark:business": "node scripts/benchmark-business-architecture.mjs",
    "benchmark:media-landmarks": "node scripts/benchmark-media-landmarks.mjs"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.183.1",
    "dependency-cruiser": "16.10.4",
    "esbuild": "^0.28.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
